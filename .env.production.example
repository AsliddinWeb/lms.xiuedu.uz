# ============================================================
# XIU LMS — PRODUCTION root .env (docker-compose.prod.yml uchun)
# Foydalanish:
#   cp .env.production.example .env.production
#   nano .env.production   # secret'larni to'ldiring
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
# ============================================================
# IZOH: Host portlari dev bilan bir xil saqlangan (8200-8215, 7880-7882).
# Server'dagi tashqi nginx domain -> port forward qiladi.

# --- PostgreSQL ---
POSTGRES_USER=lms
# MAJBURIY: kuchli parol qo'ying — openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=lms_xiuedu
POSTGRES_PORT=8210

# --- Redis ---
# MAJBURIY: parol — openssl rand -base64 24
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_PORT=8211

# --- MinIO ---
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_PORT=8212
MINIO_CONSOLE_PORT=8213

# --- Backend ---
BACKEND_PORT=8200
# Uvicorn worker'lar soni (kompyuter CPU'siga qarab: 2 * cpu + 1)
BACKEND_WORKERS=4

# --- Frontend ---
FRONTEND_USER_PORT=8201
FRONTEND_ADMIN_PORT=8203

# --- Frontend build-time API URL (Vite import.meta.env.VITE_API_URL) ---
# Server'dagi tashqi nginx domain -> backend:8200 ga proxy qiladi.
# Demak frontend brauzerda https://api.xiuedu.uz/api/v1 yoki shu kabi.
VITE_API_URL_USER=https://lms.xiuedu.uz/api/v1
VITE_API_URL_ADMIN=https://lms-admin.xiuedu.uz/api/v1

# --- LiveKit ---
# MAJBURIY: openssl rand -hex 32
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_KEY
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_SECRET_AT_LEAST_32_CHARS_LONG
LIVEKIT_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882
