# ============================================================
# XIU LMS — PRODUCTION yagona .env
# Foydalanish:
#   cp .env.production.example .env.production
#   nano .env.production
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# Ko'rsatma: barcha secret'lar shu yerda. Backend container compose orqali
# kerakli o'zgaruvchilarni oladi (env_file + environment interpolatsiya).
# Host portlari dev bilan bir xil — boshqa loyihalarga xalaqit bermaydi.
# ============================================================

# ============================================================
# INFRASTRUCTURE — postgres / redis / minio / livekit
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=lms
# MAJBURIY: openssl rand -hex 24  (HEX — URL-safe, base64'da +/=  borligi DATABASE_URL'ni buzadi)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=lms_xiuedu
POSTGRES_PORT=8210

# --- Redis ---
# MAJBURIY: openssl rand -hex 18  (HEX — REDIS_URL'da URL-safe bo'lishi shart)
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_PORT=8211

# --- MinIO ---
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
# MAJBURIY: openssl rand -hex 24
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_PORT=8212
MINIO_CONSOLE_PORT=8213
# Public URL — server'dagi tashqi nginx orqali ko'rinadigan manzil
MINIO_PUBLIC_URL=https://lms-cdn.xiuedu.uz

# --- LiveKit ---
LIVEKIT_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882
# MAJBURIY: openssl rand -hex 16
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_KEY
# MAJBURIY: openssl rand -hex 32 (kamida 32 belgi)
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_SECRET_AT_LEAST_32_CHARS_LONG
# Browser'dan ko'rinadigan WS URL.
# Alohida live.* subdomain yo'q — vaqtincha lms-api.xiuedu.uz orqali WS upgrade
# yoki to'g'ridan-to'g'ri server IP:7880 (Phase 5 live darslar ishlatilganda
# alohida subdomain ochirish tavsiya etiladi).
LIVEKIT_URL_PUBLIC=wss://lms-api.xiuedu.uz/livekit

# ============================================================
# BACKEND (FastAPI)
# ============================================================

BACKEND_PORT=8200
# Uvicorn workers (2 * cpu + 1)
BACKEND_WORKERS=4

# --- App ---
APP_ENV=production
APP_NAME=XIU LMS Backend
APP_VERSION=0.1.0
APP_DEBUG=false

# --- JWT ---
# MAJBURIY: openssl rand -hex 64
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (vergul bilan) ---
CORS_ORIGINS=https://lms.xiuedu.uz,https://lms-admin.xiuedu.uz

# --- Cookie ---
COOKIE_DOMAIN=.xiuedu.uz
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Frontend URL'lar (email link generatsiyasi) ---
APP_FRONTEND_URL=https://lms.xiuedu.uz
ADMIN_FRONTEND_URL=https://lms-admin.xiuedu.uz

# --- SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@xiuedu.uz
SMTP_PASSWORD=CHANGE_ME_SMTP_APP_PASSWORD
SMTP_FROM=noreply@xiuedu.uz
SMTP_USE_TLS=true

# --- 559-qaror ---
TEACHER_STUDENT_RATIO_MAX=50
BACHELOR_STUDENTS_PER_SPECIALTY_MAX=300
MASTER_STUDENTS_PER_SPECIALTY_MAX=30
ACADEMIC_YEAR=2025-2026
SEMESTER=autumn

# --- HEMIS ---
HEMIS_API_URL=https://student.xiuedu.uz
HEMIS_API_TOKEN=
HEMIS_SYNC_ENABLED=true

# --- OneID (ixtiyoriy) ---
ONEID_CLIENT_ID=
ONEID_CLIENT_SECRET=
ONEID_REDIRECT_URI=https://lms.xiuedu.uz/auth/oneid/callback
ONEID_AUTHORIZE_URL=https://my.gov.uz/oneid/v1/oauth/authorize
ONEID_TOKEN_URL=https://my.gov.uz/oneid/v1/oauth/token

# --- Eskiz SMS (kelajak) ---
ESKIZ_API_URL=https://notify.eskiz.uz/api
ESKIZ_API_TOKEN=

# --- Telegram bot (kelajak) ---
TELEGRAM_BOT_TOKEN=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=true

# --- Rate limit ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MIN=120

# ============================================================
# FRONTEND (Vue 3 + Vite)
# ============================================================

FRONTEND_USER_PORT=8201
FRONTEND_ADMIN_PORT=8203

# Vite build-time API URL (import.meta.env.VITE_API_URL)
# Frontend brauzeri shu URL'ga so'rov yuboradi. CORS_ORIGINS'da
# frontend domenlari ruxsat berilgan.
VITE_API_URL_USER=https://lms-api.xiuedu.uz/api/v1
VITE_API_URL_ADMIN=https://lms-api.xiuedu.uz/api/v1
