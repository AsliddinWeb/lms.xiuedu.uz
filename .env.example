# ============================================================
# XIU LMS Platform — root .env (docker-compose uchun)
# Faqat dev muhit qiymatlari. Production uchun .env alohida.
#
# IZOH: Host portlari 82xx oralig'iga ko'chirilgan — lokal kompyuterda
# odatdagi 5432/6379/8000 portlar boshqa loyihalar tomonidan band bo'lishi mumkin.
# Docker konteyner ichida xizmatlar standart portlarda ishlaydi.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_dev_password
POSTGRES_DB=lms_xiuedu
POSTGRES_PORT=8210

# --- Redis ---
REDIS_PORT=8211

# --- MinIO ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_dev_password
MINIO_PORT=8212
MINIO_CONSOLE_PORT=8213

# --- Mailhog (dev SMTP) ---
MAILHOG_SMTP_PORT=8214
MAILHOG_UI_PORT=8215

# --- Backend ---
BACKEND_PORT=8200

# --- Frontend ---
FRONTEND_USER_PORT=8201
FRONTEND_ADMIN_PORT=8203
