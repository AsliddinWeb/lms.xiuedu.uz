# ============================================================
# Backend PRODUCTION .env
# Foydalanish:
#   cp backend/.env.production.example backend/.env.production
#   nano backend/.env.production   # secret'larni to'ldiring
# ============================================================

# --- App ---
APP_ENV=production
APP_NAME="XIU LMS Backend"
APP_VERSION=0.1.0
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database ---
# Compose ichida: postgres:5432
DATABASE_URL=postgresql+asyncpg://lms:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/lms_xiuedu
DATABASE_ECHO=false

# --- Redis ---
# Production'da parol qo'yilgan
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_BUCKET=lms-files
MINIO_USE_SSL=false
# Public URL: server domeni yoki IP:port
# Misol: https://storage.xiuedu.uz (server'dagi nginx 8212'ga proxy qiladi)
MINIO_PUBLIC_URL=https://storage.xiuedu.uz

# --- JWT ---
# MAJBURIY: openssl rand -hex 64 bilan generatsiya qiling
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Production domain'lari (vergul bilan)
CORS_ORIGINS=https://lms.xiuedu.uz,https://lms-admin.xiuedu.uz

# --- Cookie ---
COOKIE_DOMAIN=.xiuedu.uz
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Frontend URL'lar (email/qr link generatsiyasi) ---
APP_FRONTEND_URL=https://lms.xiuedu.uz
ADMIN_FRONTEND_URL=https://lms-admin.xiuedu.uz

# --- Email (real SMTP) ---
# MAJBURIY: real SMTP server (mailhog production'da yo'q)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@xiuedu.uz
SMTP_PASSWORD=CHANGE_ME_SMTP_APP_PASSWORD
SMTP_FROM=noreply@xiuedu.uz
SMTP_USE_TLS=true

# --- 559-qaror talablari ---
TEACHER_STUDENT_RATIO_MAX=50
BACHELOR_STUDENTS_PER_SPECIALTY_MAX=300
MASTER_STUDENTS_PER_SPECIALTY_MAX=30
ACADEMIC_YEAR=2025-2026
SEMESTER=autumn

# --- HEMIS integratsiya (real prod URL) ---
HEMIS_API_URL=https://student.xiuedu.uz
HEMIS_API_TOKEN=
HEMIS_SYNC_ENABLED=true

# --- OneID (e-davlat SSO, agar ulansa) ---
ONEID_CLIENT_ID=
ONEID_CLIENT_SECRET=
ONEID_REDIRECT_URI=https://lms.xiuedu.uz/auth/oneid/callback
ONEID_AUTHORIZE_URL=https://my.gov.uz/oneid/v1/oauth/authorize
ONEID_TOKEN_URL=https://my.gov.uz/oneid/v1/oauth/token

# --- Live (LiveKit) ---
LIVE_DEFAULT_PROVIDER=native
# Compose'da: ws://livekit:7880 (internal)
LIVEKIT_URL_INTERNAL=ws://livekit:7880
# Browser dan: server domeni yoki IP
LIVEKIT_URL_PUBLIC=wss://live.xiuedu.uz
# MAJBURIY: openssl rand -hex 32 bilan generatsiya
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_KEY
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_SECRET_AT_LEAST_32_CHARS_LONG
LIVEKIT_TOKEN_TTL_SECONDS=21600

# --- Eskiz (SMS, kelajakda) ---
ESKIZ_API_URL=https://notify.eskiz.uz/api
ESKIZ_API_TOKEN=

# --- Telegram bot (notif relay, kelajakda) ---
TELEGRAM_BOT_TOKEN=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=true

# --- Security headers / Rate limit (Phase 7f) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MIN=120
