# ============================================================
# Backend (.env) — dev qiymatlar.
# Production .env alohida boshqariladi (sirlar repo'ga tushmaydi).
# ============================================================

# --- App ---
APP_ENV=development
APP_NAME="XIU LMS Backend"
APP_VERSION=0.1.0
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database ---
# Docker compose ichida (default): postgres:5432
# Hostdan (uvicorn lokal): localhost:8210
DATABASE_URL=postgresql+asyncpg://lms:lms_dev_password@postgres:5432/lms_xiuedu
DATABASE_ECHO=false

# --- Redis ---
# Docker ichida: redis:6379  |  Hostdan: localhost:8211
REDIS_URL=redis://redis:6379/0

# --- MinIO ---
# Docker ichida: minio:9000  |  Hostdan: localhost:8212
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_dev_password
MINIO_BUCKET=lms-files
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:8212

# --- JWT ---
# Production'da: openssl rand -hex 64
JWT_SECRET_KEY=dev_secret_change_me_in_production_e3b0c44298fc1c149afbf4c8996fb924
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Vergul bilan ajratilgan ro'yxat
CORS_ORIGINS=http://localhost:8201,http://localhost:8203

# --- Cookie ---
# Production'da: .xiuedu.uz
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Frontend URL'lar (email link generatsiyasi uchun) ---
APP_FRONTEND_URL=http://localhost:8201
ADMIN_FRONTEND_URL=http://localhost:8203

# --- Email (Mailhog dev) ---
# Docker ichida: mailhog:1025  |  Hostdan: localhost:8214
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@xiuedu.uz
SMTP_USE_TLS=false

# --- 559-qaror talablari ---
TEACHER_STUDENT_RATIO_MAX=50
BACHELOR_STUDENTS_PER_SPECIALTY_MAX=300
MASTER_STUDENTS_PER_SPECIALTY_MAX=30
ACADEMIC_YEAR=2025-2026
SEMESTER=autumn

# --- Integratsiyalar (Phase 5+ uchun bo'sh qoldirilgan) ---
ONEID_CLIENT_ID=
ONEID_CLIENT_SECRET=
ONEID_REDIRECT_URI=
ONEID_AUTHORIZE_URL=https://my.gov.uz/oneid/v1/oauth/authorize
ONEID_TOKEN_URL=https://my.gov.uz/oneid/v1/oauth/token

HEMIS_API_URL=
HEMIS_API_TOKEN=

# --- Live (Phase 5) — Native WebRTC via LiveKit (self-hosted, tashqi xizmatsiz) ---
LIVE_DEFAULT_PROVIDER=native
# LiveKit self-hosted (docker-compose.yml: livekit service, port 7880)
LIVEKIT_URL_INTERNAL=ws://livekit:7880
LIVEKIT_URL_PUBLIC=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_at_least_32_characters_long
LIVEKIT_TOKEN_TTL_SECONDS=21600

CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

ESKIZ_API_URL=https://notify.eskiz.uz/api
ESKIZ_API_TOKEN=

TELEGRAM_BOT_TOKEN=

OTJBAT_API_URL=
OTJBAT_API_KEY=
TSDIN_API_URL=
TSDIN_API_KEY=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=false
