{
  "name": "lms-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "XIU LMS frontend (Vue 3) — user va admin ikkita alohida build",
  "scripts": {
    "dev:user": "vite --mode user",
    "dev:admin": "vite --mode admin",
    "build:user": "vue-tsc --noEmit && vite build --mode user",
    "build:admin": "vue-tsc --noEmit && vite build --mode admin",
    "build": "pnpm build:user && pnpm build:admin",
    "preview:user": "vite preview --mode user --port 8201",
    "preview:admin": "vite preview --mode admin --port 8203",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.19",
    "@heroicons/vue": "^2.1.3",
    "@livekit/track-processors": "^0.7.2",
    "@sentry/vue": "^10.53.1",
    "@vueuse/core": "^10.9.0",
    "axios": "^1.6.8",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "face-api.js": "^0.22.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "livekit-client": "^2.18.9",
    "lucide-vue-next": "^0.358.0",
    "pinia": "^2.1.7",
    "vee-validate": "^4.12.6",
    "vue": "^3.4.21",
    "vue-i18n": "^9.10.2",
    "vue-router": "^4.3.0",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.5",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vitest": "^1.4.0",
    "vue-tsc": "^2.0.7"
  }
}
